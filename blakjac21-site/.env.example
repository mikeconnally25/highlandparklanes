# Guess the Balance — streamer admin token (server secret)
# Copy to .env.local, set your own value, restart dev server
GUESS_ADMIN_TOKEN=change-me-to-a-secret-token

# Optional: signing secret for site login cookies
SESSION_SECRET=change-me-session-secret

# Kick OAuth (required for Create account / Sign in)
# Create an app at https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Must match an allowed redirect URL on the Kick app exactly
KICK_REDIRECT_URI=http://localhost:3000/api/account/kick/callback
# Used for post-login redirects in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
