# Guess the Balance — streamer admin token (server secret)
# Copy to .env.local, set your own value, restart dev server
# Optional legacy fallback for scripts; Kick admin login is preferred.
GUESS_ADMIN_TOKEN=change-me-to-a-secret-token

# Kick username(s) that can see/use Streamer controls (comma-separated)
# Defaults to Blakjac21 / KICK_CHANNEL_SLUG when unset
ADMIN_KICK_USERNAME=Blakjac21
# Optional: Kick user id(s) for a precise match instead of/in addition to username
# ADMIN_KICK_USER_ID=

# Signing secret for site login cookies (use a long random string in production)
SESSION_SECRET=change-me-session-secret

# --- Kick OAuth (required for Create account / Sign in) ---
# 1. Create an app: https://kick.com/settings/developer
# 2. Add Redirect URL exactly as KICK_REDIRECT_URI below
# 3. Scope needed: user:read
# 4. Paste Client ID + Client Secret here, then restart
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Local example (use localhost, not 127.0.0.1):
KICK_REDIRECT_URI=http://localhost:3000/api/account/kick/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Upstash Redis REST — shared bonus-hunt state across Vercel instances
# (required for OBS overlay to see bonuses reliably in production)
# Create a free DB at https://upstash.com then paste:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
